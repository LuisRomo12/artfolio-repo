# Database configuration
# Example: postgresql://username:password@localhost:5432/artfolio
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/artfolio_db

# Security & Authentication
# Generate a secure secret using: openssl rand -hex 32
JWT_SECRET_KEY=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server configuration
HOST=0.0.0.0
PORT=8000

# Cloudinary configuration (https://console.cloudinary.com/settings)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS Allowed Origins (comma-separated list)
ALLOWED_ORIGINS=http://localhost:5173,https://yourproductiondomain.com

